# Konfiguracja Supabase
# 1. Zarejestruj się bezpłatnie na https://supabase.com i stwórz projekt.
# 2. Wklej i uruchom kod z pliku supabase_schema.sql w zakładce "SQL Editor".
# 3. Skopiuj Project URL oraz anon key z: Project Settings -> API.
# 4. Na Vercel dodaj poniższe zmienne w: Project Settings -> Environment Variables.

VITE_SUPABASE_URL=https://twoj-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=twoj-anon-public-key
